# Configuración de variables de entorno
# Copia este archivo a .env.local para desarrollo local

# URL base de la API local
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# URL de registro institucional SIJE
NEXT_PUBLIC_SIJE_PROJECT_URL=https://sije.episundc.pe/proyecto

# Control de Registro de Proyectos
NEXT_PUBLIC_REGISTRO_ABIERTO=false

# Puerto de la aplicación
PORT=3001
